<template>
  <div class="root" onclick="tap">
    <div class="ground"></div>
    <div class="player" style="top: {{pt}}px;"></div>
    <div class="ob" style="left: {{o0x}}px; top: {{o0t}}px; width: {{o0w}}px; height: {{o0h}}px;"></div>
    <div class="ob" style="left: {{o1x}}px; top: {{o1t}}px; width: {{o1w}}px; height: {{o1h}}px;"></div>
    <div class="ob" style="left: {{o2x}}px; top: {{o2t}}px; width: {{o2w}}px; height: {{o2h}}px;"></div>
    <text class="score">{{score}}</text>
    <text class="msg">{{msg}}</text>
  </div>
</template>

<style>
  .root { width: 466px; height: 466px; background-color: #12182b; }
  .ground { position: absolute; left: 0px; top: 330px; width: 466px; height: 136px; background-color: #3ddc84; }
  .player { position: absolute; left: 120px; width: 30px; height: 44px; background-color: #ffd740; border-radius: 8px; }
  .ob { position: absolute; background-color: #ff5252; }
  .score { position: absolute; left: 0px; top: 60px; width: 466px; text-align: center; font-size: 40px; color: #ffffff; }
  .msg { position: absolute; left: 0px; top: 130px; width: 466px; text-align: center; font-size: 28px; color: #ffffff; }
</style>

<script>
import storage from '@system.storage'

const GY = 330
const PX = 120
const PW = 30
const PH = 44

export default {
  data: {
    pt: 286,
    score: 0,
    msg: 'Тап — старт',
    o0x: 600, o0t: 280, o0w: 30, o0h: 50,
    o1x: 900, o1t: 280, o1w: 30, o1h: 50,
    o2x: 1200, o2t: 280, o2w: 30, o2h: 50
  },

  onInit() {
    this.state = 'ready'
    this.best = 0
    this.resetVars()
    try {
      storage.get({
        key: 'best',
        success: (v) => { this.best = parseInt(v) || 0 },
        fail: () => {}
      })
    } catch (e) {}
  },

  onShow() {
    if (!this.timer) {
      this.timer = setInterval(() => this.tick(), 50)
    }
  },

  onHide() {
    clearInterval(this.timer)
    this.timer = null
    if (this.state === 'play') {
      this.state = 'ready'
      this.msg = 'Тап — старт'
    }
  },

  onDestroy() {
    clearInterval(this.timer)
    this.timer = null
  },

  resetVars() {
    this.y = GY
    this.vy = 0
    this.jumps = 0
    this.sc = 0
    this.obs = [
      { x: 560, w: 30, h: 50 },
      { x: 880, w: 30, h: 50 },
      { x: 1200, w: 30, h: 50 }
    ]
  },

  tap() {
    if (this.state === 'ready' || this.state === 'dead') {
      this.resetVars()
      this.state = 'play'
      this.msg = ''
      this.jump()
    } else if (this.state === 'play') {
      this.jump()
    }
  },

  jump() {
    if (this.jumps < 2) {
      this.vy = this.jumps === 0 ? -17 : -15
      this.jumps++
    }
  },

  die() {
    this.state = 'dead'
    const s = Math.floor(this.sc)
    if (s > this.best) {
      this.best = s
      try { storage.set({ key: 'best', value: String(s) }) } catch (e) {}
    }
    this.msg = 'Конец! Рекорд ' + this.best
  },

  tick() {
    if (this.state !== 'play') return

    const speed = Math.min(9 + this.sc / 300, 15)
    this.sc += speed * 0.1

    // физика
    this.vy += 1.2
    this.y += this.vy
    if (this.y >= GY) {
      this.y = GY
      this.vy = 0
      this.jumps = 0
    }

    // препятствия
    let far = 0
    for (let i = 0; i < 3; i++) {
      const o = this.obs[i]
      o.x -= speed
      if (o.x > far) far = o.x
    }
    for (let i = 0; i < 3; i++) {
      const o = this.obs[i]
      if (o.x + o.w < 0) {
        o.x = Math.max(far, 466) + 260 + Math.random() * 200
        o.w = 26 + Math.floor(Math.random() * 16)
        o.h = 36 + Math.floor(Math.random() * 36)
        far = o.x
      }
      if (PX + PW - 4 > o.x && PX + 4 < o.x + o.w && this.y > GY - o.h + 4) {
        this.die()
      }
    }

    // обновление экрана
    const o = this.obs
    this.pt = Math.round(this.y - PH)
    this.score = Math.floor(this.sc)
    this.o0x = Math.round(o[0].x); this.o0w = o[0].w; this.o0h = o[0].h; this.o0t = GY - o[0].h
    this.o1x = Math.round(o[1].x); this.o1w = o[1].w; this.o1h = o[1].h; this.o1t = GY - o[1].h
    this.o2x = Math.round(o[2].x); this.o2w = o[2].w; this.o2h = o[2].h; this.o2t = GY - o[2].h
  }
}
</script>
